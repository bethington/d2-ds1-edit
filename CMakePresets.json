{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Visual Studio 2022 (x86)",
            "description": "Build with the installed x86 vcpkg libraries using Visual Studio 2022",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "Win32",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/tmp/build-vs2022",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": {
                    "type": "PATH",
                    "value": "${sourceDir}/build/vcpkg_installed/x86-windows"
                }
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ci",
            "displayName": "CI Build (Windows, Ninja + MSVC)",
            "description": "Ninja so the preset does not pin a Visual Studio version",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                },
                "VCPKG_TARGET_TRIPLET": "x86-windows"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (Ninja, system Allegro 5)",
            "description": "Uses pkg-config against liballegro5-dev",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS (Ninja, Homebrew Allegro 5)",
            "description": "Uses pkg-config against `brew install allegro`",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "dev",
            "displayName": "Dev (optimized + debug symbols)",
            "configurePreset": "default",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "ci-release",
            "displayName": "CI Release",
            "configurePreset": "ci"
        },
        {
            "name": "linux",
            "displayName": "Linux Release",
            "configurePreset": "linux"
        },
        {
            "name": "macos",
            "displayName": "macOS Release",
            "configurePreset": "macos"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Run Tests",
            "configurePreset": "default",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci",
            "displayName": "CI Tests",
            "configurePreset": "ci",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux",
            "displayName": "Linux Tests",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "macos",
            "displayName": "macOS Tests",
            "configurePreset": "macos",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "fast",
            "displayName": "Fast (unit suites, no display or game data)",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8,
                "noTestsAction": "error"
            },
            "configuration": "Release",
            "filter": {
                "include": {
                    "label": "fast"
                }
            }
        },
        {
            "name": "check",
            "displayName": "Check (fast + golden core, adversarial slice, display tests)",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8,
                "noTestsAction": "error"
            },
            "configuration": "Release",
            "filter": {
                "include": {
                    "label": "fast|check"
                }
            }
        },
        {
            "name": "full",
            "displayName": "Full (everything registered, incl. full adversarial campaign)",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8,
                "noTestsAction": "error"
            },
            "configuration": "Release"
        },
        {
