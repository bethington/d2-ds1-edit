            "configurePreset": "ci",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8,
                "noTestsAction": "error"
            }
        },
        {
            "name": "linux-fast",
            "displayName": "Fast (unit suites, no display or game data)",
            "configurePreset": "linux",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8,
                "noTestsAction": "error"
            },
            "filter": {
                "include": {
                    "label": "fast"
                }
            }
        },
        {
