# Build output (entire bin/ directory is build output now)
bin/
backup/
build/
cmake-build/
*.obj
*.o
*.lib
*.a
*.so
*.dylib

# Debug files
*.pdb
*.ilk
*.idb
*.map

# Temporary / runtime files
*.tmp
data/Tmp/

# Visual Studio / IDE
.vs/
# .vscode/tasks.json is now tracked (was gitignored, caused it to disappear on branch switches)
*.vcxproj.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Python
__pycache__/
*.pyc

# Game data files (users supply their own from Diablo II installation)
assets/tiles/
assets/*_errors.*
assets/*_working.*
*.mpq

# OS generated
.DS_Store
Thumbs.db
*~

# Archives
*.zip
*.rar
*.7z
*.tar.gz
*.tar.bz2

# Legacy
.d2workshop/

# Local developer configuration
.mcp.json
CMakeUserPresets.json
ds1edit.ini
.env
*.env
!.env.example

# Export/upscale smoke test artifacts
all_dc6_log.txt
*smoke*/

# Palette and colormap caches the editor extracts from the user's own MPQs.
# Blizzard data: generated at run time from the player's installation, never
# committed. data/ is the pre-2.1 location and is no longer read by anything.
/data/
assets/editor/pal*.bin
assets/editor/cmap*.bin

# Generated version file
data/version

# Release packaging output
/dist/

# Game-derived and generated runtime caches -- never commit these.
# pal*.bin are verbatim copies of Blizzard's Data\Global\Palette\ActN\Pal.pl2,
# extracted from the user's own MPQs on first run and cached here.
# cmap*.bin are colormaps the editor computes from those palettes.
# assets/excel/*.txt are Blizzard's data tables; the editor reads them from the
# MPQ chain and only falls back to these if a local copy happens to exist.
assets/editor/pal*.bin
assets/editor/cmap*.bin
assets/editor/gamma.dat
assets/excel/*.txt

# Undo scratch, created at runtime.
/tmp/
