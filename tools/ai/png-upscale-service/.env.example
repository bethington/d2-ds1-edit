# Host port published by docker-compose (container always listens on 8080).
PNG_UPSCALE_PORT=8084

# Tile size (pixels). 0 = no tiling (fastest, requires more VRAM).
# Lower (e.g. 256) on memory-constrained GPUs.
REALESRGAN_TILE=0

# fp16 inference when CUDA is available. Set to 0 to force fp32.
REALESRGAN_HALF=1
