{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "default"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build DS1Edit Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "dev"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build DS1Edit Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "release"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "default"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Package Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "--preset", "release",
                "--target", "package"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
