{
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/mpq",
                "C:/vcpkg/installed/x86-windows/include"
            ],
            "defines": [
                "_DEBUG",
                "WIN32",
                "USE_CONSOLE"
            ],
            "cStandard": "c89",
            "cppStandard": "c++98",
            "intelliSenseMode": "windows-msvc-x86",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ]
}
