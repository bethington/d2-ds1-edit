; DS1Edit Configuration File
; ==========================
; Copy this file to "Ds1edit.ini" and edit the paths below to match
; your Diablo II installation directory. If Ds1edit.ini is missing
; on first launch the editor writes a fresh copy with code defaults
; (which differ slightly from this sample's recommended values —
; e.g. screen is 800x600 fullscreen by default; this sample picks
; 1280x720 windowed for new users).


; D2 install directory. When set, the editor resolves the standard Blizzard
; MPQs (patch_d2, d2exp, d2data, d2char) from this folder automatically.
; If left blank, the editor auto-detects via the Windows registry and a
; short list of common install paths.
; ==========================================================================
d2_install =

; Per-MPQ overrides. An explicit path here always wins over d2_install /
; auto-detection. Leave blank to let resolution fill the slot from
; d2_install. When a file is loaded, the editor scans mod_dir first, then
; patch_d2, d2exp, d2data, d2char (in that order, matching D2 itself).
; ==========================================================================
d2char   =
d2data   =
d2exp    =
patch_d2 =
mod_dir  =

; data_dir overrides where the editor looks for its runtime data
; (palettes, gamma table, obj.txt, ds1edit.dt1, undo temp files).
; Default is "Data\" relative to the exe. Leave blank for default.
; This key is read separately from the rest (no entry in the type
; registry) so its absence is not flagged in the load log.
; ==========================================================================
; data_dir =


; Optional remote PNG upscaling service. When enabled and a base URL is set,
; export actions can offer None / 2x / 4x modes using the configured service.
; ===========================================================================
upscale_enabled     = NO
upscale_service_url =


; PNG export filter. When YES (default), multi-frame DC6 files (animations,
; multi-direction sprites) are skipped during export. Multi-frame export to
; a dedicated animation format is a planned future feature; for now PNG
; output is single-frame only. Flip to NO to fall back to the prior behavior
; (export every frame of multi-frame DC6 alongside single-frame icons).
; ==========================================================================
export_dc6_single_frame_only = YES


; Examples of explicit configuration (uncomment and edit if needed):
; d2_install = C:\Diablo2
; d2exp      = D:\custom\d2exp.mpq
; mod_dir    = C:\Diablo2\mods\my_mod
; upscale_enabled     = YES
; upscale_service_url = http://10.0.10.30:8084
; data_dir            = C:\Diablo2\ds1edit\Data\


; Screen configuration. Code defaults are full_screen=YES, 800x600;
; this sample recommends 1280x720 windowed for modern displays.
; ==========================================================================
full_screen   = NO
screen_width  = 1280
screen_height = 720


; Try to use this refresh rate, if possible. Not all drivers can control
; this at all, and even when they can, not all rates will be possible on
; all hardware, so the actual settings may differ from what you requested.
; Some non-exhaustive values: 60, 70, 72, 75, 85, 100, 120
; ==========================================================================
refresh_rate = 60


; Speed of scrolls, in pixels.
; ==========================================================================
keyb_scroll_x  = 40
keyb_scroll_y  = 20
mouse_scroll_x = 20
mouse_scroll_y = 10
edit_scroll_x  = 20
edit_scroll_y  = 20


; Speed of scroll in the Object Editing window, in rows.
; ==========================================================================
obj_edit_scroll = 2


; Misc options
; ==========================================================================


; Default gamma correction.
; Valid values: 0.60, 0.62, ..., 0.98, 1.00, 1.10, 1.20, ..., 3.00
; Code default is 1.30; sample uses 1.20 for a slightly less washed-out
; look on calibrated monitors.
; --------------------------------------------------------------------------
gamma_correction = 1.20


; Allow Type 2 objects of higher act?
; If NOT set to YES, the editor allows it (i.e. unrestricted).
; --------------------------------------------------------------------------
only_normal_type2 = YES


; Always upgrade DS1 to 2 floor layers and 4 wall layers on save?
; If NOT set to YES, the editor leaves layer counts untouched.
; --------------------------------------------------------------------------
always_max_layers = YES


; Resize the sprites when zooming.
; --------------------------------------------------------------------------
stretch_sprite = YES


; When editing an object, allow scrolling the main tile editing window
; with the arrow keys.
; --------------------------------------------------------------------------
winobj_can_scroll_keyb = YES


; When editing an object, allow scrolling the main tile editing window
; via mouse on the screen border.
; --------------------------------------------------------------------------
winobj_can_scroll_mouse = NO


; After Centering (the 'C' key), which zoom level to use?
; Valid values: NO_CHANGE, 1:1, 1:2, 1:4, 1:8, 1:16
; Code default is 1:1; sample uses NO_CHANGE so centering doesn't
; surprise the user by also resetting their zoom level.
; --------------------------------------------------------------------------
center_zoom = NO_CHANGE


; Default zoom level when opening a DS1 file.
; Valid values: 1:1, 1:2, 1:4, 1:8, 1:16
; --------------------------------------------------------------------------
default_zoom = 1:1


; Sizes of object tables in DLL for type 1 and type 2.
; Stock values are 60 entries per act for type 1 and 150 per act for type 2.
; Don't change these unless you have a modified DLL.
; --------------------------------------------------------------------------
nb_type1_per_act = 60
nb_type2_per_act = 150


; Minimize file size of saved DS1?
; --------------------------------------------------------------------------
ds1_saved_minimize = YES


; Reduce scrolling speed when zoomed out?
; --------------------------------------------------------------------------
lower_speed_zoom_out = NO


; Enable the workspace feature?
; --------------------------------------------------------------------------
workspace_enable = YES


; Compose-mode export options
; ==========================================================================


; When YES, the compose-mode export action labels its output folders with
; full descriptive names (e.g. "Necromancer", "Andariel") drawn from the
; appropriate TXT tables. Filenames keep their compact 2-char D2 codes
; regardless. When NO (default), folders also use the 2-char codes so the
; output mirrors the MPQ structure exactly.
; --------------------------------------------------------------------------
compose_use_full_folder_names = NO


; Export presets shown in the unified Ctrl+Shift+A export action's scope
; picker. Each entry is "name = type | pattern" where type is one of
; all/dt1/dc6/dcc and pattern is a glob matched against virtual asset
; paths under the mod overlay. Order in this section is the order in the
; picker. Wildcard syntax: * (any chars except \), ? (one char except \),
; ** (any number of subfolders, including zero).
; ===========================================================================
[export_presets]
items_all     = dc6 | data\global\items\*.dc6
items_inv     = dc6 | data\global\items\inv*.dc6
items_potions = dc6 | data\global\items\pot*.dc6
tiles_all     = dt1 | data\global\tiles\**\*.dt1
tiles_act1    = dt1 | data\global\tiles\ACT1\**\*.dt1
tiles_act2    = dt1 | data\global\tiles\ACT2\**\*.dt1
tiles_act3    = dt1 | data\global\tiles\ACT3\**\*.dt1
tiles_act4    = dt1 | data\global\tiles\ACT4\**\*.dt1
tiles_act5    = dt1 | data\global\tiles\ACT5\**\*.dt1


; Animation mode presets for the compose-mode multi-select picker.
; Each entry is "name = comma-separated D2 mode codes". Mode codes:
;   NU (idle), TW (town walk), WL (walk), RN (run),
;   A1 (attack 1), A2 (attack 2), DT (death), GH (get hit),
;   SC (cast), TH (throw), KK (kick), BL (block), S1..S8 (skill 1..8).
; The picker also always shows an "All modes" entry as a fallback.
; ===========================================================================
[char_mode_presets]
idle_only       = NU
idle_walk       = NU, WL
standard_combat = NU, WL, A1, DT


; Weapon-class presets for the compose-mode multi-select picker
; (only shown for player chars; monsters/NPCs/objects don't have weapon
; variants). Codes:
;   HTH (bare hands), 1HS (1H sword), 1HT (1H throwing),
;   2HS (2H sword), 2HT (2H throwing), BOW, XBW,
;   STF (staff), HT1, HT2 (twin handed).
; The picker also always shows an "All weapons" entry as a fallback.
; ===========================================================================
[char_weapon_presets]
bare_hands = HTH
melee      = HTH, 1HS, 2HS
ranged     = HTH, BOW, XBW
magic      = HTH, STF
common     = HTH, 1HS, BOW, STF


; Export default output paths and CLI defaults. When set, the CLI
; falls back to these when the matching --out= flag is omitted, and
; the GUI folder pickers pre-populate from them. Leave blank to keep
; --out= mandatory and the picker default-empty.
;   compose_output         used by export-compose / export
;   raw_dcc_output         used by export-raw --type=dcc
;   raw_dc6_output         used by export-raw --type=dc6
;   raw_dt1_output         used by export-raw --type=dt1
;   compose_modes_preset   named [char_mode_presets] preset to use
;                          when --mode= is omitted (e.g. idle_only)
;   compose_weapons_preset named [char_weapon_presets] preset to use
;                          when --weapon= is omitted (e.g. bare_hands)
;   verbose                YES = always run CLI exports as if -v was
;                          passed
; ===========================================================================
[export_defaults]
compose_output         =
raw_dcc_output         =
raw_dc6_output         =
raw_dt1_output         =
compose_modes_preset   =
compose_weapons_preset =
verbose                = NO

; Examples:
; compose_output         = C:\d2_exports\compose
; raw_dc6_output         = C:\d2_exports\dc6
; compose_modes_preset   = idle_only
; compose_weapons_preset = bare_hands

